# Toonflow 本地 dev 环境 seed 配置
#
# 1. 复制为仓库根目录的 .env.dev.local
# 2. 只填写你实际拥有的模型供应商；不需要的整段留空或删除
# 3. 该文件已被 .gitignore 忽略，不要提交真实密钥

# 多租户测试账号（无论是否开启多租户都会预置）
TOONFLOW_DEV_ADMIN_USER=admin
TOONFLOW_DEV_ADMIN_PASSWORD=admin123456
TOONFLOW_DEV_USER=test
TOONFLOW_DEV_USER_PASSWORD=test123456
# 1 开启多租户（额外监听 10888，模型写入 SQL 平台目录），0 保持 Toonflow 默认的单用户模式
TOONFLOW_DEV_MULTITENANT=1

# 语言模型供应商（OpenAI 兼容示例；也可换成 anthropic-messages）
TOONFLOW_DEV_TEXT_PROVIDER_ID=deepseek
TOONFLOW_DEV_TEXT_PROVIDER_LABEL=DeepSeek
TOONFLOW_DEV_TEXT_API_URL=https://api.deepseek.com
TOONFLOW_DEV_TEXT_API_KEY=sk-REPLACE_ME
TOONFLOW_DEV_TEXT_PROTOCOL=openai-completions
# 格式：模型ID:展示名，多个用英文逗号分隔
TOONFLOW_DEV_TEXT_MODELS=deepseek-chat:DeepSeek Chat,deepseek-reasoner:DeepSeek Reasoner
# 可选：不填则由 Toonflow 按模型 ID 使用内置上下文/输出上限
# TOONFLOW_DEV_TEXT_CONTEXT_WINDOW=131072
# TOONFLOW_DEV_TEXT_MAX_OUTPUT_TOKENS=8192

# 媒体模型供应商：apiMart / metaso / compshare / none
# APIMart 示例（图片+视频）
TOONFLOW_DEV_MEDIA_PROVIDER=apiMart
TOONFLOW_DEV_MEDIA_API_KEY=sk-REPLACE_ME
TOONFLOW_DEV_MEDIA_IS_OVERSEAS=1
# 需要发布到多租户创作端的媒体模型：模型ID:展示名:类型:单价，多个用英文逗号分隔
# 类型：image / video / audio；单价单位 CNY，视频按秒，图片与音频按次
TOONFLOW_DEV_MEDIA_ROUTES=seedance-2.5:Seedance 2.5:video:0.001

# 文本模型在创作端展示的价格（CNY / 百万 Token）
# TOONFLOW_DEV_TEXT_PRICE_INPUT=0.001
# TOONFLOW_DEV_TEXT_PRICE_OUTPUT=0.001
# TOONFLOW_DEV_TEXT_PRICE_CACHE_READ=0
# TOONFLOW_DEV_TEXT_PRICE_CACHE_WRITE=0

# 普通测试账号的初始余额（CNY）
TOONFLOW_DEV_USER_BALANCE=100

# 秘塔示例：
# TOONFLOW_DEV_MEDIA_PROVIDER=metaso
# TOONFLOW_DEV_MEDIA_API_KEY=sk-REPLACE_ME
# TOONFLOW_DEV_MEDIA_BASE_URL=https://metaso.cn/api/minimax

# 优云智算示例：
# TOONFLOW_DEV_MEDIA_PROVIDER=compshare
# TOONFLOW_DEV_MEDIA_API_KEY=sk-REPLACE_ME
# TOONFLOW_DEV_MEDIA_MINIMAX_API_KEY=sk-REPLACE_ME

# 需要覆盖供应商默认配置时使用 JSON 对象（可选）
# TOONFLOW_DEV_MEDIA_CONFIG_JSON={"isOverseas":"2"}

# 示例工作区名称
TOONFLOW_DEV_PROJECT_NAME=Toonflow Dev
