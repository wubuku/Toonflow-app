# Toonflow 本地 dev 环境配置（dev.sh / dev-seed.ts 读取）
#
# 快速开始：
#   1. cp scripts/dev.env.example .env.dev.local
#   2. 只填下面 3 个 Key（其余项已给好默认值，不需要改）：
#        ① TOONFLOW_DEV_TEXT_API_KEY          豆包 Seed LLM（文本 / Agent）
#        ② TOONFLOW_DEV_MEDIA_API_KEY         Seedance（视频）
#        ③ TOONFLOW_DEV_MEDIA_IMAGE_API_KEY   Seedream（图片）
#   3. ./scripts/dev.sh
#
# Key 获取：https://console.volcengine.com/ark → API Key 管理
# 三个 Key 可以是同一个 Key；③ 留空时会自动复用 ②。
# 重复运行 dev.sh 会按供应商 ID 覆盖已写入的配置（含 Key）；本文件未声明的供应商保持不变。
# 该文件已被 .gitignore 忽略，不要提交真实密钥。

# ── 测试账号（dev-seed 自动创建） ─────────────────────────────
TOONFLOW_DEV_ADMIN_USER=admin
TOONFLOW_DEV_ADMIN_PASSWORD=admin123456
TOONFLOW_DEV_USER=test
TOONFLOW_DEV_USER_PASSWORD=test123456
# 1 = 开启多租户（额外监听 10888，模型写入 SQL 平台目录）；0 = 单用户模式
TOONFLOW_DEV_MULTITENANT=1

# ── ① 文本模型：火山方舟 豆包 Seed ───────────────────────────
TOONFLOW_DEV_TEXT_PROVIDER_ID=doubao
TOONFLOW_DEV_TEXT_PROVIDER_LABEL=火山方舟（豆包 Seed）
# 默认北京地域；如使用其他地域，只改这一行
TOONFLOW_DEV_TEXT_API_URL=https://ark.cn-beijing.volces.com/api/v3
TOONFLOW_DEV_TEXT_API_KEY=REPLACE_WITH_DOUBAO_SEED_LLM_API_KEY
TOONFLOW_DEV_TEXT_PROTOCOL=openai-completions
# 格式：模型ID:展示名，多个用英文逗号分隔。
# 如控制台开通的是其他版本，替换为对应模型 ID（例如 doubao-seed-2-0-pro-260215）。
TOONFLOW_DEV_TEXT_MODELS=doubao-seed-2-1-pro-260628:Doubao Seed 2.1 Pro
# 可选：不填则使用 Toonflow 默认上下文 262144 / 最大输出 32768
# TOONFLOW_DEV_TEXT_CONTEXT_WINDOW=262144
# TOONFLOW_DEV_TEXT_MAX_OUTPUT_TOKENS=32768

# ── ②③ 媒体模型：火山方舟 Seedream（图片）+ Seedance（视频） ──
TOONFLOW_DEV_MEDIA_PROVIDER=volcengine
# Seedance Key（视频）
TOONFLOW_DEV_MEDIA_API_KEY=REPLACE_WITH_SEEDANCE_API_KEY
# Seedream Key（图片）；留空则自动复用上面的 Seedance Key
TOONFLOW_DEV_MEDIA_IMAGE_API_KEY=REPLACE_WITH_SEEDREAM_API_KEY
# 默认北京地域；如使用其他地域，只改这一行
TOONFLOW_DEV_MEDIA_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 可选：发布到多租户创作端的媒体路由，格式 模型ID:展示名:类型:单价（图片按次、视频按秒）
# 不填则默认使用：
#   doubao-seedream-5-0-pro-260628:Seedream 5.0 Pro:image:0.001
#   doubao-seedance-2-5-260628:Seedance 2.5:video:0.001
# TOONFLOW_DEV_MEDIA_ROUTES=doubao-seedream-5-0-pro-260628:Seedream 5.0 Pro:image:0.001,doubao-seedance-2-5-260628:Seedance 2.5:video:0.001

# 可选：覆盖供应商默认配置（JSON 对象，浅合并）
# TOONFLOW_DEV_MEDIA_CONFIG_JSON={"baseUrl":"https://ark.cn-beijing.volces.com/api/v3"}

# ── 文本模型展示价格（可选，CNY / 百万 Token） ───────────────
# TOONFLOW_DEV_TEXT_PRICE_INPUT=0.001
# TOONFLOW_DEV_TEXT_PRICE_OUTPUT=0.001
# TOONFLOW_DEV_TEXT_PRICE_CACHE_READ=0
# TOONFLOW_DEV_TEXT_PRICE_CACHE_WRITE=0

# ── 其他媒体供应商示例（不使用时保持注释；同时只能启用一个 MEDIA_PROVIDER） ──
# APIMart（图片 + 视频）
# TOONFLOW_DEV_MEDIA_PROVIDER=apiMart
# TOONFLOW_DEV_MEDIA_API_KEY=sk-REPLACE_ME
# TOONFLOW_DEV_MEDIA_IS_OVERSEAS=1
#
# 秘塔
# TOONFLOW_DEV_MEDIA_PROVIDER=metaso
# TOONFLOW_DEV_MEDIA_API_KEY=sk-REPLACE_ME
# TOONFLOW_DEV_MEDIA_BASE_URL=https://metaso.cn/api/minimax
#
# 优云智算
# TOONFLOW_DEV_MEDIA_PROVIDER=compshare
# TOONFLOW_DEV_MEDIA_API_KEY=sk-REPLACE_ME
# TOONFLOW_DEV_MEDIA_MINIMAX_API_KEY=sk-REPLACE_ME

# ── 其他 ─────────────────────────────────────────────────────
# 普通测试账号的初始余额（CNY）
TOONFLOW_DEV_USER_BALANCE=100
# 示例工作区名称
TOONFLOW_DEV_PROJECT_NAME=Toonflow Dev
